# Provedor preferido no ambiente: anthropic | gemini
# (o modal do app tem prioridade sobre isso)
AI_PROVIDER=
VITE_AI_PROVIDER=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Gemini (Google) — use GEMINI_API_KEY ou GOOGLE_API_KEY
GEMINI_API_KEY=
GOOGLE_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GOOGLE_API_KEY=

# Sem chave configurada (modal ou ambiente), a plataforma fica bloqueada.
