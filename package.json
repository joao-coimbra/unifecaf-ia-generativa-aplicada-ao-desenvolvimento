{
  "name": "unifecaf-ia-generativa-aplicada-ao-desenvolvimento",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@unifecaf-ia-generativa-aplicada-ao-desenvolvimento/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "catalog:",
    "@unifecaf-ia-generativa-aplicada-ao-desenvolvimento/config": "workspace:*",
    "lefthook": "latest",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.3.14"
}
